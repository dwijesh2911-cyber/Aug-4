<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grid</title>
    <style>
        *{
            padding: 5px;
            margin: 2px;
        }
        .container{
            display: grid;
            height: 100vh;
            grid-column:25% 25% 25% 25% ;
            grid-row: 20% 20% 20% 40%;
        }
        .head{
            background-color: rgb(239, 135, 74);
            grid-column: 1/5;
            grid-row: 1/2;
        }
        .b1{
            background-color: blueviolet;
            grid-column: 1/2;
            grid-row: 2/3;
        
        }
        .b2{
            background-color: pink;
            grid-column: 2/3;
            grid-row: 2/3;
        }
        .b3{
            background-color: aquamarine;
            grid-column: 3/4;
            grid-row: 2/3;
        }
        .sb{
            background-color: red;
            grid-column: 4/5;
            grid-row: 2/4;
        }
        .mc{
            background-color: darkkhaki;
            grid-column: 1/4;
            grid-row: 3/4;
        }
        .foot{
            background-color: aquamarine;
            grid-column: 1/5;
            grid-row: 4/5;
        }

    </style>
</head>
<body>

<div class="container"> 
    <div class="head"> Header</div>
    <div class="b1"> Box-1</div>
    <div class="b2"> Box-2</div>
    <div class="b3"> Box-3</div>
    <div class="sb"> Side-Bar</div>
    <div class="mc"> Main-Content</div>
    <div class="foot"> Footer</div>
    
</div>
    
</body>
</html>
